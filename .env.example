# Copy this file to .env or run: npm run setup:local-env
# Do not commit .env. Generate distinct random secrets for every environment.
DATABASE_URL="mysql://club_portal:replace-with-db-password@localhost:3306/cyber_security_club"
SESSION_SECRET="generate-a-random-secret-with-at-least-32-characters"
SESSION_ENCRYPTION_KEY="generate-a-base64-encoded-32-byte-key"
SESSION_MAX_AGE_MS=28800000
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUDIT_LOG_RETENTION_DAYS=365

# First-run President provisioning only. These values are read only from .env.
PRESIDENT_MEMBER_ID="set-your-president-member-id"
PRESIDENT_INITIAL_PASSWORD="set-a-strong-password-only-in-your-local-env"
PRESIDENT_NAME="President"

# Required for production password reset delivery. Keep empty for local development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# The browser API prefix. This value is safe to expose; never put a secret in VITE_ variables.
VITE_API_BASE_URL=/api/v1
