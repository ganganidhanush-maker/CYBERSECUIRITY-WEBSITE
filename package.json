{
  "name": "cybersecuirity-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-local-db.js && concurrently -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "start": "node server/server.js",
    "build": "prisma generate && vite build",
    "render-build": "prisma generate && vite build",
    "railway-build": "prisma generate && vite build",
    "vercel-build": "prisma generate && vite build",
    "postinstall": "prisma generate || true",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test test/**/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset-development-accounts": "node prisma/reset-development-accounts.js",
    "setup:local-env": "node scripts/setup-local-env.js",
    "db:local:start": "node scripts/provision-local-db.js && docker compose -f docker-compose.local.yml up -d",
    "db:local:start-native": "powershell -ExecutionPolicy Bypass -File scripts/start-local-mariadb.ps1",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vitejs/plugin-react": "^6.0.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "mariadb": "^3.5.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.5",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0"
  }
}
