generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PRESIDENT
  VICE_PRESIDENT
  TREASURER
  EVENT_MANAGEMENT
  MEDIA_LEAD
  TECH_TEAM
  PR_TEAM
  CULTURAL
  SECRETARY
  ADMIN
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum UserPermission {
  ACCOUNT_MANAGEMENT
  DASHBOARD_VIEW
  EVENTS_VIEW
  EVENT_MANAGE
  EVENT_REGISTER
  REGISTRATIONS_VIEW
  PAYMENTS_VIEW
  PAYMENTS_VERIFY
  QR_PASSES_VIEW
  GALLERY_VIEW
  GALLERY_MANAGE
  TEAM_MANAGE
  SETTINGS_MANAGE
  AUDIT_VIEW
  CHAT_USE
  SUGGESTIONS_CREATE
  FEEDBACK_CREATE
  NOTIFICATIONS_VIEW
  PROFILE_EDIT
}

model User {
  id                     String                 @id @default(cuid()) @db.VarChar(191)
  memberId               String                 @unique @map("member_id") @db.VarChar(32)
  passwordHash           String                 @map("password_hash") @db.VarChar(255)
  role                   Role
  isPrimaryAdmin         Boolean                @default(false) @map("is_primary_admin")
  accountStatus          AccountStatus          @default(ACTIVE) @map("account_status")
  failedLoginAttempts    Int                    @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?              @map("locked_until")
  passwordResetTokenHash String?                @unique @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt DateTime?              @map("password_reset_expires_at")
  totpSecretEncrypted    String?                @map("totp_secret_encrypted") @db.VarChar(512)
  totpEnabled            Boolean                @default(false) @map("totp_enabled")
  lastLogoutAllDevicesAt DateTime?              @map("last_logout_all_devices_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  lastLogin              DateTime?              @map("last_login")
  profile                Profile?
  permissions            PermissionAssignment[]
  auditEntries           AuditLog[]             @relation("AuditActor")
  auditTargets           AuditLog[]             @relation("AuditTarget")
  complaints             Complaint[]

  @@map("users")
}

model PermissionAssignment {
  id         String         @id @default(cuid()) @db.VarChar(191)
  userId     String         @map("user_id") @db.VarChar(191)
  permission UserPermission
  createdAt  DateTime       @default(now()) @map("created_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([permission])
  @@map("permission_assignments")
}

model Profile {
  id           String   @id @default(cuid()) @db.VarChar(191)
  userId       String   @unique @map("user_id") @db.VarChar(191)
  name         String?  @db.VarChar(120)
  rollNumber   String?  @map("roll_number") @db.VarChar(64)
  department   String?  @db.VarChar(120)
  year         Int?
  email        String?  @unique @db.VarChar(191)
  phone        String?  @db.VarChar(32)
  profileImage String?  @map("profile_image") @db.LongText
  bio          String?  @db.VarChar(500)
  instagramUrl String?  @map("instagram_url") @db.VarChar(255)
  githubUrl    String?  @map("github_url") @db.VarChar(255)
  linkedinUrl  String?  @map("linkedin_url") @db.VarChar(255)
  portfolioUrl String?  @map("portfolio_url") @db.VarChar(255)
  skills       String?  @db.VarChar(500)
  achievements String?  @db.LongText
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AuditLog {
  id           String   @id @default(cuid()) @db.VarChar(191)
  actorUserId  String?  @map("actor_user_id") @db.VarChar(191)
  action       String   @db.VarChar(100)
  targetUserId String?  @map("target_user_id") @db.VarChar(191)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id                      String              @id @default(cuid()) @db.VarChar(191)
  title                   String              @db.VarChar(255)
  shortDescription        String?             @map("short_description") @db.VarChar(500)
  description             String?             @db.LongText
  eventType               String              @map("event_type") @db.VarChar(100)
  dateTime                DateTime            @map("date_time")
  startTime               String?             @map("start_time") @db.VarChar(50)
  endTime                 String?             @map("end_time") @db.VarChar(50)
  venue                   String?             @db.VarChar(255)
  location                String?             @db.VarChar(255)
  capacity                Int?
  photoUrl                String?             @map("photo_url") @db.LongText
  status                  String              @default("UPCOMING") @db.VarChar(50)
  coordinatorName         String?             @map("coordinator_name") @db.VarChar(120)
  coordinatorContact      String?             @map("coordinator_contact") @db.VarChar(120)
  organizingTeam          String?             @map("organizing_team") @db.VarChar(255)
  speakerName             String?             @map("speaker_name") @db.VarChar(120)
  speakerPhoto            String?             @map("speaker_photo") @db.LongText
  speakerDesignation      String?             @map("speaker_designation") @db.VarChar(120)
  registrationDeadline    DateTime?           @map("registration_deadline")
  contactEmail            String?             @map("contact_email") @db.VarChar(191)
  contactPhone            String?             @map("contact_phone") @db.VarChar(32)
  socialLinks             Json?               @map("social_links")
  rules                   String?             @db.LongText
  eligibility             String?             @db.LongText
  requiredMaterials       String?             @map("required_materials") @db.LongText
  agenda                  String?             @db.LongText
  faq                     Json?
  notes                   String?             @db.LongText
  requiresPayment         Boolean             @default(false) @map("requires_payment")
  paymentAmount           Decimal?            @map("payment_amount") @db.Decimal(10, 2)
  paymentQrUrl            String?             @map("payment_qr_url") @db.LongText
  paymentUpiId            String?             @map("payment_upi_id") @db.VarChar(120)
  paymentInstructions     String?             @map("payment_instructions") @db.LongText
  paymentDeadline         DateTime?           @map("payment_deadline")
  requirePaymentProof     Boolean             @default(false) @map("require_payment_proof")
  allowMultipleActivities Boolean             @default(false) @map("allow_multiple_activities")
  createdBy               String              @map("created_by") @db.VarChar(191)
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  registrations           EventRegistration[]
  formFields              EventFormField[]
  activities              EventActivity[]

  @@map("events")
}

model EventActivity {
  id           String   @id @default(cuid()) @db.VarChar(191)
  eventId      String   @map("event_id") @db.VarChar(191)
  name         String   @db.VarChar(120)
  description  String?  @db.VarChar(500)
  price        Decimal  @default(0.00) @db.Decimal(10, 2)
  capacity     Int?
  isAvailable  Boolean  @default(true) @map("is_available")
  instructions String?  @db.LongText
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_activities")
}

model EventFormField {
  id         String   @id @default(cuid()) @db.VarChar(191)
  eventId    String   @map("event_id") @db.VarChar(191)
  fieldName  String   @map("field_name") @db.VarChar(255)
  fieldType  String   @map("field_type") @db.VarChar(50)
  isRequired Boolean  @default(false) @map("is_required")
  options    String?  @db.LongText
  createdAt  DateTime @default(now()) @map("created_at")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_form_fields")
}

model EventRegistration {
  id                 String    @id @default(cuid()) @db.VarChar(191)
  eventId            String    @map("event_id") @db.VarChar(191)
  userId             String    @map("user_id") @db.VarChar(191)
  registeredAt       DateTime  @default(now()) @map("registered_at")
  formData           Json?     @map("form_data")
  selectedActivities Json?     @map("selected_activities")
  totalAmount        Decimal   @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  paymentStatus      String    @default("FREE") @map("payment_status") @db.VarChar(50)
  paymentReference   String?   @map("payment_reference") @db.VarChar(120)
  paymentProofUrl    String?   @map("payment_proof_url") @db.LongText
  paymentVerifiedAt  DateTime? @map("payment_verified_at")
  paymentVerifiedBy  String?   @map("payment_verified_by") @db.VarChar(191)
  paymentNotes       String?   @map("payment_notes") @db.VarChar(500)
  branch             String?   @db.VarChar(120)
  section            String?   @db.VarChar(64)
  year               Int?
  emergencyContact   String?   @map("emergency_contact") @db.VarChar(32)
  teamName           String?   @map("team_name") @db.VarChar(120)
  github             String?   @db.VarChar(120)
  status             String    @default("REGISTERED") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at")
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

model GalleryAlbum {
  id          String         @id @default(cuid()) @db.VarChar(191)
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  coverImage  String?        @map("cover_image") @db.LongText
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  photos      GalleryPhoto[]

  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String       @id @default(cuid()) @db.VarChar(191)
  albumId   String       @map("album_id") @db.VarChar(191)
  imageUrl  String       @map("image_url") @db.LongText
  caption   String?      @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at")
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("gallery_photos")
}

model Complaint {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  subject   String   @db.VarChar(255)
  message   String   @db.LongText
  status    String   @default("OPEN") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

model ClubTeamMember {
  id             String   @id @default(cuid()) @db.VarChar(191)
  name           String   @db.VarChar(120)
  roleTitle      String   @map("role_title") @db.VarChar(120)
  photoUrl       String?  @map("photo_url") @db.LongText
  bio            String?  @db.VarChar(500)
  collegeEmail   String?  @map("college_email") @db.VarChar(191)
  contactEmail   String?  @map("contact_email") @db.VarChar(191)
  instagramUrl   String?  @map("instagram_url") @db.VarChar(255)
  githubUrl      String?  @map("github_url") @db.VarChar(255)
  linkedinUrl    String?  @map("linkedin_url") @db.VarChar(255)
  twitterUrl     String?  @map("twitter_url") @db.VarChar(255)
  portfolioUrl   String?  @map("portfolio_url") @db.VarChar(255)
  skills         String?  @db.VarChar(500)
  year           Int?
  branch         String?  @db.VarChar(120)
  achievements   String?  @db.LongText
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  approvalStatus String   @default("APPROVED") @map("approval_status") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("club_team_members")
}

model ClubSetting {
  key       String   @id @db.VarChar(100)
  value     String?  @db.LongText
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("club_settings")
}
